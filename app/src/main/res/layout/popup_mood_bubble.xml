<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.2: contents of the chat-bubble PopupWindow that appears above
     a tapped mood slot. The TextView is the only child so the popup's
     measured size is its own preferred size (no padding from a wrapping
     parent). MyKeyboardView sets the text colour and tints the layer-list
     background at show-time so the bubble follows the active theme. -->
<org.fossify.commons.views.MyTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mood_bubble_text"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/mood_bubble_background"
    android:gravity="center"
    android:paddingStart="@dimen/mood_bubble_horizontal_padding"
    android:paddingTop="@dimen/mood_bubble_vertical_padding"
    android:paddingEnd="@dimen/mood_bubble_horizontal_padding"
    android:paddingBottom="@dimen/mood_bubble_vertical_padding"
    android:textSize="@dimen/normal_text_size"
    android:textStyle="normal"
    tools:ignore="MissingDefaultResource"
    xmlns:tools="http://schemas.android.com/tools" />
