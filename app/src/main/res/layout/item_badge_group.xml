<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 14 §7.2: one group row in the Achievements vertical list.
    Header (primary-tinted, uppercase, unlocked/total on the trailing
    edge) + a centred focus card paged by ‹ / › ImageButtons and swipe
    (nested ViewPager2) + page dots + an optional 14-day devotion strip
    (visible only for the Daily-devotion group via BadgeGroupAdapter).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="@dimen/normal_margin"
    android:paddingBottom="@dimen/small_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/normal_margin"
        android:paddingEnd="@dimen/normal_margin">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/badge_group_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:textStyle="bold"
            tools:text="Mood · Daily devotion" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/badge_group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/smaller_text_size"
            tools:text="1 / 6" />

    </LinearLayout>

    <!-- Task E: clipChildren/clipToPadding=false + vertical padding give
         the per-card MaterialCardView elevation shadow room to render
         fully top and bottom. Without this the nested ViewPager2 clipped
         the shadow flush against the card bounds. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/badge_card_height"
        android:layout_marginTop="@dimen/small_margin"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingTop="@dimen/small_margin"
        android:paddingBottom="@dimen/small_margin">

        <ImageButton
            android:id="@+id/badge_group_prev"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/achievements_prev_badge"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left_vector" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/badge_group_pager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <ImageButton
            android:id="@+id/badge_group_next"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/achievements_next_badge"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_right_vector" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/badge_group_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/small_margin"
        android:gravity="center"
        android:orientation="horizontal" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/badge_group_day_strip_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/normal_margin"
        android:layout_marginEnd="@dimen/normal_margin"
        android:layout_marginTop="@dimen/small_margin"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/small_margin">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/badge_group_day_strip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/small_margin"
                android:letterSpacing="0.05"
                android:text="@string/achievements_day_strip_label"
                android:textAllCaps="true"
                android:textSize="@dimen/smaller_text_size"
                android:textStyle="bold" />

            <org.fossify.keyboard.views.IkdBadgeDayStripView
                android:id="@+id/badge_group_day_strip"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:contentDescription="@string/achievements_day_strip_content_description" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
