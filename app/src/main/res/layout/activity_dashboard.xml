<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.11: dashboard restructured into:
      - app bar / toolbar
      - global header: Mood Filter chip row, Range toggle, KPI strip
      - vertical NavigationRail (left) + ViewPager2 (right) with five
        per-section fragments swipeable horizontally.
    Each section's full content moved into a fragment_dashboard_*.xml file.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/dashboard_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/dashboard_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:menu="@menu/menu_dashboard"
            app:title="@string/dashboard_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/dashboard_root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Global header — shared across every tab. -->
        <LinearLayout
            android:id="@+id/dashboard_global_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/activity_margin">

            <!-- Phase 9.4: Mood Filter chip row (gone until first MoodEntry).
                 Sits above the range selector — outermost filter (sessions
                 by mood) precedes time-window selection. Phase 9.11: stays
                 in the global header so chip-row state applies to every
                 tab. -->
            <HorizontalScrollView
                android:id="@+id/dashboard_mood_filter_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/dashboard_mood_filter_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <!-- Range selector. Phase 9.11: Today added as the first option. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/dashboard_range_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_today"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_week"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_month"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_all" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Global KPI strip — Sessions / Typing time / WPM / Error rate. -->
            <LinearLayout
                android:id="@+id/dashboard_kpi_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:orientation="horizontal"
                android:weightSum="4">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_sessions_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_sessions"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_typing_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_typing_time"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_wpm_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_wpm"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_error_rate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_error_rate"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Phase 9.11: NavigationRail (left) + ViewPager2 (right). The
             rail provides the vertical tab strip; the ViewPager2 provides
             horizontal swipe between tab content. -->
        <LinearLayout
            android:id="@+id/dashboard_pager_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.google.android.material.navigationrail.NavigationRailView
                android:id="@+id/dashboard_navigation_rail"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/menu_dashboard_tabs" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/dashboard_view_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal" />

        </LinearLayout>

    </LinearLayout>

    <!-- Empty state: shown when no sessions exist at all. -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/dashboard_empty_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:text="@string/dashboard_empty_message"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
