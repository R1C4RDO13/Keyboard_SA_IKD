<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.14 layout (top-to-bottom):
      - app bar / toolbar (Filters action lives here, opens
        InsightsFiltersBottomSheet)
      - Material 3 TabLayout — five icon+label tabs, MODE_FIXED + tabMinWidth=0
        so all five fit at 360dp without horizontal scroll (Phase 9.15
        dropped the Mood tab; its widgets moved into the Summary tab)
      - active-filter chip — visible only when range != Week or moodFilter != null
      - ViewPager2 (horizontal, swipeable)

    Phase 9.14.1 lifted the global KPI strip into the new Summary tab.
    Phase 9.14.2 swapped the Phase 9.12 toggle group for the TabLayout.
    Phase 9.14.3 collapsed the standalone range toggle and mood-filter
    chip strip into the bottom sheet behind the toolbar Filters icon —
    only an active-filter chip remains visible in the chrome when the
    user has changed range or mood from defaults.

    Per-tab content lives in five fragment_dashboard_*.xml files.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/dashboard_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/dashboard_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:menu="@menu/menu_dashboard"
            app:title="@string/dashboard_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/dashboard_root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Global header — shared across every tab. -->
        <LinearLayout
            android:id="@+id/dashboard_global_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/activity_margin">

            <!-- Phase 9.14.1: Global KPI strip removed — its six cells now
                 live as the 2x3 KPI grid on the new Summary tab
                 (`SummaryFragment`). The Summary tab is the new Insights
                 landing page; cards still render via the Phase 9.12
                 segmented toggle below. The tab bar redesign (TabLayout +
                 icons) lands in 9.14.2. -->

            <!-- Phase 9.14.2: Material 3 TabLayout replaces the Phase 9.12
                 MaterialButtonToggleGroup. Mode FIXED + tabMinWidth=0 +
                 tabGravity=fill so all five icon+label tabs distribute
                 evenly across the screen with no horizontal scroll
                 (Decision #2 / #3; Phase 9.15 dropped the Mood tab so the
                 count is now 5). The icon tint selector tracks the
                 Fossify theme — primary on selected, controlNormal on
                 unselected. TabLayoutMediator wires this to the pager
                 in DashboardActivity (Decision #2). -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/dashboard_tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabGravity="fill"
                app:tabIconTint="@color/dashboard_tab_icon_tint"
                app:tabIndicatorAnimationMode="elastic"
                app:tabInlineLabel="false"
                app:tabMinWidth="0dp"
                app:tabMode="fixed"
                app:tabSelectedTextColor="?attr/colorPrimary"
                app:tabTextColor="?android:attr/textColorSecondary" />

            <!-- Phase 9.14.3: active filter chip (range + mood). Visible
                 only when the user has changed either filter away from the
                 defaults (range = Week, mood = null). Tap chip body →
                 reopen the bottom sheet at the current selection; tap the
                 close icon on the right → reset both filters. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/dashboard_active_filter_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:visibility="gone"
                app:closeIcon="@drawable/ic_close_vector"
                app:closeIconVisible="true" />

            <!-- Phase 9.16: bucket-size hint. The X-axis bucket of the
                 trend charts depends on the active range — daily for
                 Week/Month, weekly for All Time, hourly for Today. This
                 small italic line surfaces that mapping consistently
                 above every tab so the user is not surprised when the
                 labels change. -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/dashboard_bucket_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:textSize="@dimen/smaller_text_size"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- Phase 9.12: ViewPager2 fills the remaining vertical space. The
             vertical NavigationRail is gone; the top toggle group above
             drives the pager and pager swipes drive the toggle. -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/dashboard_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- Empty state: shown when no sessions exist at all. -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/dashboard_empty_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:text="@string/dashboard_empty_message"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
