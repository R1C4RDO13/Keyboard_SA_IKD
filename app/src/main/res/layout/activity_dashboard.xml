<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.12: top-of-screen tab toggle group replaces the NavigationRail.
    Layout top-to-bottom:
      - app bar / toolbar
      - global KPI strip (6 cells, scrollable)
      - tab toggle (Trends / Daily Activity / Mood / Keystroke Dynamics / Habits)
      - range toggle (Today / Week / Month / All Time)
      - mood-filter chip row (gone until first MoodEntry)
      - ViewPager2 (horizontal, swipeable)
    Per-tab content lives in five fragment_dashboard_*.xml files.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/dashboard_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/dashboard_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:menu="@menu/menu_dashboard"
            app:title="@string/dashboard_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/dashboard_root_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Global header — shared across every tab. -->
        <LinearLayout
            android:id="@+id/dashboard_global_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/activity_margin">

            <!-- Phase 9.12: Global KPI strip — 6 cells (Sessions / Typing time
                 / Avg WPM / Error rate / Avg session / Longest streak). Wrapped
                 in a HorizontalScrollView so 6 cells fit on narrow screens. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/dashboard_kpi_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:minWidth="@dimen/dashboard_kpi_cell_min_width"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/small_margin"
                        android:paddingEnd="@dimen/small_margin">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/dashboard_kpi_sessions_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_value_placeholder"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_kpi_sessions"
                            android:textSize="@dimen/smaller_text_size" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:minWidth="@dimen/dashboard_kpi_cell_min_width"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/small_margin"
                        android:paddingEnd="@dimen/small_margin">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/dashboard_kpi_typing_time_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_value_placeholder"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_kpi_typing_time"
                            android:textSize="@dimen/smaller_text_size" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:minWidth="@dimen/dashboard_kpi_cell_min_width"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/small_margin"
                        android:paddingEnd="@dimen/small_margin">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/dashboard_kpi_wpm_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_value_placeholder"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_kpi_wpm"
                            android:textSize="@dimen/smaller_text_size" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:minWidth="@dimen/dashboard_kpi_cell_min_width"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/small_margin"
                        android:paddingEnd="@dimen/small_margin">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/dashboard_kpi_error_rate_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_value_placeholder"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_kpi_error_rate"
                            android:textSize="@dimen/smaller_text_size" />

                    </LinearLayout>

                    <!-- Phase 9.12: lifted from the Habits tab's internal strip. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:minWidth="@dimen/dashboard_kpi_cell_min_width"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/small_margin"
                        android:paddingEnd="@dimen/small_margin">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/dashboard_kpi_avg_session_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_value_placeholder"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_habits_kpi_avg_session"
                            android:textSize="@dimen/smaller_text_size" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:minWidth="@dimen/dashboard_kpi_cell_min_width"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/small_margin"
                        android:paddingEnd="@dimen/small_margin">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/dashboard_kpi_streak_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_value_placeholder"
                            android:textSize="@dimen/bigger_text_size"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_habits_kpi_streak"
                            android:textSize="@dimen/smaller_text_size" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Phase 9.12: top-of-screen tab toggle group. Same MaterialButton
                 toggle styling as the range toggle below — the user asked for
                 a top tab strip styled identically. Wrapped in a horizontal
                 scroller because the five tab labels (Trends, Daily Activity,
                 Mood, Keystroke Dynamics, Habits) overflow narrow widths. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:fillViewport="true"
                android:scrollbars="none">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/dashboard_tab_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_tab_trends"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_section_trends" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_tab_daily_activity"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_tab_label_daily_activity" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_tab_mood"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_section_mood" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_tab_keystroke_dynamics"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_tab_label_keystroke_dynamics" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dashboard_tab_habits"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_section_habits" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </HorizontalScrollView>

            <!-- Range selector. Phase 9.11: Today added as the first option. -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/dashboard_range_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_today"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_today" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_week"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_month"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_all" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Phase 9.4: Mood Filter chip row (gone until first MoodEntry).
                 Phase 9.11: stays in the global header so chip-row state
                 applies to every tab. Phase 9.12: moved below the range
                 toggle since the tab toggle is the new top control. -->
            <HorizontalScrollView
                android:id="@+id/dashboard_mood_filter_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:fillViewport="false"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/dashboard_mood_filter_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Phase 9.12: ViewPager2 fills the remaining vertical space. The
             vertical NavigationRail is gone; the top toggle group above
             drives the pager and pager swipes drive the toggle. -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/dashboard_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

    </LinearLayout>

    <!-- Empty state: shown when no sessions exist at all. -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/dashboard_empty_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:text="@string/dashboard_empty_message"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
