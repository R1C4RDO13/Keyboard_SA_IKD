<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/dashboard_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/dashboard_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:menu="@menu/menu_dashboard"
            app:title="@string/dashboard_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboard_nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/dashboard_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/activity_margin">

            <!-- Range selector -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/dashboard_range_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_week"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_week" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_month"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_range_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dashboard_range_all" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- KPI strip -->
            <LinearLayout
                android:id="@+id/dashboard_kpi_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:orientation="horizontal"
                android:weightSum="5">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_sessions_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_sessions"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_typing_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_typing_time"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_wpm_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_wpm"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_error_rate_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_value_placeholder"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_error_rate"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

                <!-- Phase 8: fifth KPI cell — Avg Mood (rounded emoji + precise number).
                     Hidden when no mood entries exist in the selected range. -->
                <LinearLayout
                    android:id="@+id/dashboard_kpi_avg_mood_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_kpi_avg_mood_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold"
                        tools:text="🤢 3.2" />

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_kpi_avg_mood_label"
                        android:textSize="@dimen/smaller_text_size" />

                </LinearLayout>

            </LinearLayout>

            <!-- Speed chart -->
            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:text="@string/dashboard_chart_speed"
                android:textStyle="bold" />

            <org.fossify.keyboard.views.IkdLineChartView
                android:id="@+id/dashboard_chart_speed"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/small_margin" />

            <!-- IKD chart -->
            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:text="@string/dashboard_chart_ikd"
                android:textStyle="bold" />

            <org.fossify.keyboard.views.IkdLineChartView
                android:id="@+id/dashboard_chart_ikd"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/small_margin" />

            <!-- Error rate chart -->
            <org.fossify.commons.views.MyTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:text="@string/dashboard_chart_error"
                android:textStyle="bold" />

            <org.fossify.keyboard.views.IkdLineChartView
                android:id="@+id/dashboard_chart_error"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/small_margin" />

            <!-- Phase 8: Mood-over-Time chart card. Hidden when the selected
                 range has no mood entries. Reuses the existing
                 IkdLineChartView wrapper (frozen at single-series since
                 Phase 5). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_mood_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/normal_margin">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_mood_chart_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_chart_mood_title"
                        android:textStyle="bold" />

                    <org.fossify.keyboard.views.IkdLineChartView
                        android:id="@+id/dashboard_chart_mood"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="@dimen/small_margin" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Phase 8: Mood Distribution panel — six rows in display order
                 (Happiness → Anger), each emoji + label + horizontal
                 progress bar + count. Hidden when no entries in range. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_mood_distribution_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/normal_margin">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/dashboard_mood_distribution_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dashboard_mood_distribution_title"
                        android:textStyle="bold" />

                    <include
                        android:id="@+id/dashboard_mood_row_happiness"
                        layout="@layout/item_mood_distribution_row" />

                    <include
                        android:id="@+id/dashboard_mood_row_surprise"
                        layout="@layout/item_mood_distribution_row" />

                    <include
                        android:id="@+id/dashboard_mood_row_disgust"
                        layout="@layout/item_mood_distribution_row" />

                    <include
                        android:id="@+id/dashboard_mood_row_sadness"
                        layout="@layout/item_mood_distribution_row" />

                    <include
                        android:id="@+id/dashboard_mood_row_fear"
                        layout="@layout/item_mood_distribution_row" />

                    <include
                        android:id="@+id/dashboard_mood_row_anger"
                        layout="@layout/item_mood_distribution_row" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Empty state: shown when no sessions exist -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/dashboard_empty_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:text="@string/dashboard_empty_message"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
