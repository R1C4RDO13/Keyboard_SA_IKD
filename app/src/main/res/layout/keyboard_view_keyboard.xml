<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/keyboard_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar_holder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/keyboard_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/clipboard_clear"
            android:layout_width="@dimen/toolbar_icon_height"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginStart="@dimen/medium_margin"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_clipboard_data"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_delete_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Phase 13: pinned-clipboard moved to the leading edge so the
             elevated mood bar on the trailing edge doesn't cover it. -->
        <ImageView
            android:id="@+id/pinned_clipboard_items"
            android:layout_width="@dimen/toolbar_icon_height"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginStart="@dimen/medium_margin"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clipboard_pinned"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_clipboard_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/clipboard_clear"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Phase 13: settings_cog moved to the leading edge so the
             elevated mood bar on the trailing edge doesn't cover it. -->
        <ImageView
            android:id="@+id/settings_cog"
            android:layout_width="@dimen/toolbar_icon_height"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginStart="@dimen/medium_margin"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_settings_cog_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/pinned_clipboard_items"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Phase 13: one-tap shortcut into the Insights dashboard
             (Phase 3 / 9). Lives immediately right of settings_cog so
             the leading-edge icon row reads as a logical cluster:
             clear → clipboard → settings → insights. -->
        <ImageView
            android:id="@+id/insights_button"
            android:layout_width="@dimen/toolbar_icon_height"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginStart="@dimen/medium_margin"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dashboard_title"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_insights_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/settings_cog"
            app:layout_constraintTop_toTopOf="parent" />

        <org.fossify.keyboard.views.InlineContentViewHorizontalScrollView
            android:id="@+id/suggestions_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginEnd="@dimen/normal_margin"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/voice_input_button"
            app:layout_constraintStart_toEndOf="@+id/insights_button"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/suggestions_items_holder"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/clipboard_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoLink="none"
                    android:background="@drawable/clipboard_background"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:lines="1"
                    android:paddingStart="@dimen/activity_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:paddingEnd="@dimen/activity_margin"
                    android:paddingBottom="@dimen/small_margin"
                    android:textSize="@dimen/label_text_size"
                    tools:text="Clipboard content" />

                <LinearLayout
                    android:id="@+id/autofill_suggestions_holder"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />

            </LinearLayout>

        </org.fossify.keyboard.views.InlineContentViewHorizontalScrollView>

        <!-- Phase 13: voice_input_button keeps its right-cluster role but
             now anchors directly to the parent's trailing edge — the mood
             bar floats over it as an elevated sibling. Voice is normally
             GONE unless `Config.voiceInputMethod` is set, so the visual
             collision is rare in practice. -->
        <ImageView
            android:id="@+id/voice_input_button"
            android:layout_width="@dimen/toolbar_icon_height"
            android:layout_height="@dimen/toolbar_icon_height"
            android:layout_marginEnd="@dimen/medium_margin"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/switch_to_voice_typing"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_microphone_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/top_keyboard_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <org.fossify.keyboard.views.MyKeyboardView
        android:id="@+id/keyboard_view"
        style="@style/MyKeyboardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/theme_dark_background_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <RelativeLayout
        android:id="@+id/emoji_palette_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar_holder">

        <RelativeLayout
            android:id="@+id/emoji_palette_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/emoji_palette_close"
                android:layout_width="@dimen/toolbar_icon_height"
                android:layout_height="@dimen/toolbar_icon_height"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/medium_margin"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/emojis"
                android:padding="@dimen/small_margin"
                android:src="@drawable/ic_arrow_left_vector" />

            <TextView
                android:id="@+id/emoji_palette_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_toEndOf="@+id/emoji_palette_close"
                android:ellipsize="end"
                android:lines="1"
                android:text="@string/emojis"
                android:textSize="@dimen/big_text_size" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/emoji_content_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/emoji_palette_bottom_bar"
            android:layout_below="@+id/emoji_palette_top_bar">

            <org.fossify.commons.views.MyRecyclerView
                android:id="@+id/emojis_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/small_margin"
                android:scrollbars="vertical" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/emoji_palette_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/emoji_palette_mode_change"
                android:layout_width="@dimen/emoji_palette_btn_size"
                android:layout_height="@dimen/emoji_palette_btn_size"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/medium_margin"
                android:background="@drawable/keyboard_key_selector"
                android:gravity="center"
                android:text="@string/abc"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/emoji_categories_strip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_marginEnd="@dimen/medium_margin"
                android:layout_toStartOf="@+id/emoji_palette_backspace"
                android:layout_toEndOf="@+id/emoji_palette_mode_change"
                android:gravity="center"
                android:orientation="horizontal" />

            <ImageButton
                android:id="@+id/emoji_palette_backspace"
                android:layout_width="@dimen/emoji_palette_btn_size"
                android:layout_height="@dimen/emoji_palette_btn_size"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/medium_margin"
                android:background="@drawable/keyboard_key_selector"
                android:contentDescription="@string/delete"
                android:src="@drawable/ic_clear_vector" />

        </RelativeLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/clipboard_manager_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clickable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar_holder">

        <RelativeLayout
            android:id="@+id/clipboard_manager_top_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/clipboard_manager_close"
                android:layout_width="@dimen/toolbar_icon_height"
                android:layout_height="@dimen/toolbar_icon_height"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/medium_margin"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/clipboard"
                android:padding="@dimen/small_margin"
                android:src="@drawable/ic_arrow_left_vector" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/clipboard_manager_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_toStartOf="@+id/clipboard_manager_manage"
                android:layout_toEndOf="@+id/clipboard_manager_close"
                android:ellipsize="end"
                android:lines="1"
                android:text="@string/clipboard"
                android:textSize="@dimen/big_text_size" />

            <ImageView
                android:id="@+id/clipboard_manager_manage"
                android:layout_width="@dimen/toolbar_icon_height"
                android:layout_height="@dimen/toolbar_icon_height"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/medium_margin"
                android:layout_marginEnd="@dimen/medium_margin"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/manage_clipboard_items"
                android:padding="@dimen/small_margin"
                android:src="@drawable/ic_set_as_vector" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/clipboard_content_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/clipboard_manager_top_bar">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/clipboard_content_placeholder_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/activity_margin"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/big_margin"
                android:paddingEnd="@dimen/big_margin"
                android:text="@string/manage_clipboard_empty"
                android:textSize="@dimen/bigger_text_size"
                android:visibility="gone" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/clipboard_content_placeholder_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/clipboard_content_placeholder_1"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/activity_margin"
                android:gravity="center_horizontal"
                android:paddingStart="@dimen/big_margin"
                android:paddingEnd="@dimen/big_margin"
                android:text="@string/manage_clipboard_label"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone" />

            <org.fossify.commons.views.MyRecyclerView
                android:id="@+id/clips_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/small_margin"
                app:layoutManager="androidx.recyclerview.widget.StaggeredGridLayoutManager"
                app:spanCount="2" />

        </RelativeLayout>

        <ImageView
            android:id="@+id/top_clipboard_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/divider"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </RelativeLayout>

    <!-- Phase 13: trailing-edge persistent mood bar.
         Lifted out of toolbar_holder so it can float above both the regular
         toolbar AND the emoji drawer's top bar. Declared LAST in
         keyboard_holder so the natural draw order places it on top of
         emoji_palette_holder + clipboard_manager_holder. Trailing-edge
         anchor auto-flips under RTL via end_toEndOf="parent".
         app:elevation adds a Material shadow so the floating capsule reads
         as overlay (parent keyboard_holder has clipChildren="false" so the
         Phase 8.4 dance peak and Phase 8.2 chat bubble are not clipped).
         The bar is a sibling of toolbar_holder (not its child), so
         settings_cog cannot directly reference it via end_toStartOf —
         applyMoodBarConstraints sets settings_cog.marginEnd at runtime
         instead (push left by bar width + bar marginEnd) and restores
         the XML default `medium_margin` when Config.showMoodBar = false.
         Phase 8 / 8.1 / 8.2 / 8.4 / 8.5 semantics on the slot taps are
         preserved verbatim — see MyKeyboardView.onMoodSlotClicked /
         applyMoodBarLayout. -->
    <LinearLayout
        android:id="@+id/mood_bar"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/mood_bar_height"
        android:layout_marginEnd="@dimen/small_margin"
        android:background="@drawable/mood_bar_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mood_bar_horizontal_padding"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/toolbar_holder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/toolbar_holder">

        <!-- Phase 13: chevron + slots + indicator reordered so the chip
             (indicator) stays pinned to the trailing screen edge and the
             chevron moves leftward as the bar expands. Mirrors the
             original left-anchored design where the chip stayed pinned
             and the chevron tracked the bar's growing edge. -->
        <ImageView
            android:id="@+id/mood_bar_toggle_chevron"
            android:layout_width="@dimen/mood_bar_chevron_size"
            android:layout_height="@dimen/mood_bar_chevron_size"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mood_bar_toggle_content_description"
            android:padding="@dimen/small_margin"
            android:src="@drawable/ic_chevron_right_vector" />

        <LinearLayout
            android:id="@+id/mood_bar_expanded_slots"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Phase 13: right-anchored bar expands leftward, so the
                 slot adjacent to the chip is the FIRST one the user
                 reveals as the bar grows. Order is reversed in XML
                 (privacy → anger → fear → sadness → disgust → surprise
                 → happiness, left-to-right) so happiness sits next to
                 the chip and is revealed first; privacy lives at the
                 far-left end of the row. The `mood_bar_privacy_gap`
                 separates privacy from the emotion column on its
                 marginEnd. -->
            <TextView
                android:id="@+id/mood_bar_privacy"
                android:layout_width="@dimen/mood_bar_button_size"
                android:layout_height="@dimen/mood_bar_button_size"
                android:layout_marginEnd="@dimen/mood_bar_privacy_gap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/privacy_toggle_content_description"
                android:gravity="center"
                android:text="@string/mood_bar_privacy_emoji"
                android:textSize="@dimen/mood_bar_button_text_size" />

            <TextView
                android:id="@+id/mood_bar_anger"
                android:layout_width="@dimen/mood_bar_button_size"
                android:layout_height="@dimen/mood_bar_button_size"
                android:layout_marginEnd="@dimen/mood_bar_button_gap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mood_label_anger"
                android:gravity="center"
                android:text="@string/mood_bar_anger_emoji"
                android:textSize="@dimen/mood_bar_button_text_size" />

            <TextView
                android:id="@+id/mood_bar_fear"
                android:layout_width="@dimen/mood_bar_button_size"
                android:layout_height="@dimen/mood_bar_button_size"
                android:layout_marginEnd="@dimen/mood_bar_button_gap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mood_label_fear"
                android:gravity="center"
                android:text="@string/mood_bar_fear_emoji"
                android:textSize="@dimen/mood_bar_button_text_size" />

            <TextView
                android:id="@+id/mood_bar_sadness"
                android:layout_width="@dimen/mood_bar_button_size"
                android:layout_height="@dimen/mood_bar_button_size"
                android:layout_marginEnd="@dimen/mood_bar_button_gap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mood_label_sadness"
                android:gravity="center"
                android:text="@string/mood_bar_sadness_emoji"
                android:textSize="@dimen/mood_bar_button_text_size" />

            <TextView
                android:id="@+id/mood_bar_disgust"
                android:layout_width="@dimen/mood_bar_button_size"
                android:layout_height="@dimen/mood_bar_button_size"
                android:layout_marginEnd="@dimen/mood_bar_button_gap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mood_label_disgust"
                android:gravity="center"
                android:text="@string/mood_bar_disgust_emoji"
                android:textSize="@dimen/mood_bar_button_text_size" />

            <TextView
                android:id="@+id/mood_bar_surprise"
                android:layout_width="@dimen/mood_bar_button_size"
                android:layout_height="@dimen/mood_bar_button_size"
                android:layout_marginEnd="@dimen/mood_bar_button_gap"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mood_label_surprise"
                android:gravity="center"
                android:text="@string/mood_bar_surprise_emoji"
                android:textSize="@dimen/mood_bar_button_text_size" />

            <TextView
                android:id="@+id/mood_bar_happiness"
                android:layout_width="@dimen/mood_bar_button_size"
                android:layout_height="@dimen/mood_bar_button_size"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mood_label_happiness"
                android:gravity="center"
                android:text="@string/mood_bar_happiness_emoji"
                android:textSize="@dimen/mood_bar_button_text_size" />

        </LinearLayout>

        <TextView
            android:id="@+id/mood_bar_collapsed_indicator"
            android:layout_width="@dimen/mood_bar_collapsed_indicator_width"
            android:layout_height="@dimen/mood_bar_button_size"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mood_bar_toggle_content_description"
            android:gravity="center"
            android:text="@string/mood_bar_collapsed_placeholder"
            android:textSize="@dimen/mood_bar_collapsed_indicator_text_size" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
