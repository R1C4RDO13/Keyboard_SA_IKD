<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.14.1: Summary tab layout — 2-column x 3-row grid of KPI
    tiles. Each tile is a `MaterialCardView` (the click target), with an
    `<include>` inflating the shared `item_summary_kpi_tile.xml` body.
    Internal child views are reached via
    `ItemSummaryKpiTileBinding.bind(includeRoot)` from `SummaryFragment`
    — same pattern as the Phase 8 mood-distribution rows.

    Layout order (left-to-right, top-to-bottom):
      Sessions · Typing time
      WPM · Error rate
      Avg session · Longest streak

    Click routing per Decision #7: Sessions / Typing time / Avg session
    / Streak → Habits; WPM / Error rate → Trends.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_summary_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/normal_margin">

        <!-- Row 1: Sessions · Typing time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_tile_sessions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/small_margin"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <include
                    android:id="@+id/summary_tile_sessions_body"
                    layout="@layout/item_summary_kpi_tile" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_tile_typing_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/small_margin"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <include
                    android:id="@+id/summary_tile_typing_time_body"
                    layout="@layout/item_summary_kpi_tile" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Row 2: WPM · Error rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_tile_wpm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/small_margin"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <include
                    android:id="@+id/summary_tile_wpm_body"
                    layout="@layout/item_summary_kpi_tile" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_tile_error_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/small_margin"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <include
                    android:id="@+id/summary_tile_error_rate_body"
                    layout="@layout/item_summary_kpi_tile" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Row 3: Avg session · Longest streak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_tile_avg_session"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/small_margin"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <include
                    android:id="@+id/summary_tile_avg_session_body"
                    layout="@layout/item_summary_kpi_tile" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_tile_streak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/small_margin"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <include
                    android:id="@+id/summary_tile_streak_body"
                    layout="@layout/item_summary_kpi_tile" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/fragment_summary_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/activity_margin"
            android:text="@string/dashboard_tab_empty_message"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
