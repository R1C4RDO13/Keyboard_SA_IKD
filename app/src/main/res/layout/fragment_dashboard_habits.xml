<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.11/9.12: Habits tab content. Phase 9.12 dropped the internal
    4-cell KPI strip — three of those values now live on the global
    KPI strip at the activity level (Avg session + Longest streak), and
    Sessions / Typing time were already there. Only the four trend charts
    plus the Phase 9.10 backspaces-vs-autocorrects scatter remain.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_habits_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/normal_margin">

        <!-- Phase 9.3: Habits trend charts. -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/dashboard_chart_habits_session_duration_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_chart_habits_session_duration_title"
            android:textStyle="bold"
            android:visibility="gone" />

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_habits_session_duration"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin"
            android:visibility="gone" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dashboard_chart_habits_sessions_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:text="@string/dashboard_chart_habits_sessions_title"
            android:textStyle="bold"
            android:visibility="gone" />

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_habits_sessions"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin"
            android:visibility="gone" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dashboard_chart_habits_error_rate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:text="@string/dashboard_chart_habits_error_rate_title"
            android:textStyle="bold"
            android:visibility="gone" />

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_habits_error_rate"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin"
            android:visibility="gone" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dashboard_chart_habits_flight_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:text="@string/dashboard_chart_habits_flight_title"
            android:textStyle="bold"
            android:visibility="gone" />

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_habits_flight"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin"
            android:visibility="gone" />

        <!-- Phase 9.10: Activity Quality scatter card. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_activity_quality_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normal_margin">

                <org.fossify.commons.views.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_chart_activity_quality_title"
                    android:textStyle="bold" />

                <com.github.mikephil.charting.charts.ScatterChart
                    android:id="@+id/dashboard_activity_quality_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/small_margin" />

                <org.fossify.commons.views.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin"
                    android:text="@string/dashboard_activity_quality_subtitle"
                    android:textSize="@dimen/smaller_text_size"
                    android:textStyle="italic" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Empty placeholder when this tab has no data to show. -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/fragment_habits_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/activity_margin"
            android:text="@string/dashboard_tab_empty_message"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
