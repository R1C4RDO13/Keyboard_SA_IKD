<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.4: one chip in the dashboard's Mood Filter chip row. Inflated
    seven times by `DashboardActivity.setupMoodFilterChips()` — one for
    "All" plus six for the Ekman emoji. Tinted via `applyChipColors()` at
    runtime; theme switches propagate on the next onResume.
-->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/small_margin"
    android:checkable="true"
    app:checkedIconVisible="false" />
