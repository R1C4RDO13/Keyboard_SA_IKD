<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 14 (Option B): one group section header in the flat
    Achievements list. Primary-tinted, uppercase, bold group name on the
    leading edge + an "unlocked / total" count on the trailing edge.
    Same text style as the carousel header it replaces; the count uses
    R.string.achievements_group_count_format. When this row is the
    Daily-devotion header, BadgeListAdapter also makes the embedded
    day-strip card (below) visible — kept in the same item so the strip
    always sits directly under its header in catalog order.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/normal_margin"
    android:paddingEnd="@dimen/normal_margin"
    android:paddingTop="@dimen/normal_margin"
    android:paddingBottom="@dimen/small_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/badge_group_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:textStyle="bold"
            tools:text="Mood · Daily devotion" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/badge_group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/smaller_text_size"
            tools:text="1 / 6" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/badge_group_day_strip_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="@dimen/card_elevation"
        app:strokeWidth="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/small_margin">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/badge_group_day_strip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/small_margin"
                android:letterSpacing="0.05"
                android:text="@string/achievements_day_strip_label"
                android:textAllCaps="true"
                android:textSize="@dimen/smaller_text_size"
                android:textStyle="bold" />

            <org.fossify.keyboard.views.IkdBadgeDayStripView
                android:id="@+id/badge_group_day_strip"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:contentDescription="@string/achievements_day_strip_content_description" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
