<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 14 (Option B): one full-width badge row in the flat
    Achievements list. Mirrors the mockup's `.rows .bdg`:
      emoji (flush-left) · mid column [bold title, small desc, and a thin
      determinate progress bar when locked] · right column [unlocked: a
      "✓ <date>" primary caption; locked: a faint "<current>/<target>"].
    BadgeListAdapter flips locked vs. unlocked state: locked → greyed
    emoji (alpha 0.55) + faded title/desc + progress bar; unlocked →
    full-opacity emoji + 1dp primary inset stroke + date caption.
    All colours come from the runtime Fossify theme at bind time
    (MaterialCardView's default ?attr/colorSurface does not track it).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/badge_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/normal_margin"
    android:layout_marginEnd="@dimen/normal_margin"
    android:layout_marginBottom="@dimen/small_margin"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/normal_margin">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/badge_row_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/normal_margin"
            android:textSize="28sp"
            tools:text="🍀" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/badge_row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="Habit Forming" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/badge_row_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_margin"
                android:textSize="@dimen/smaller_text_size"
                tools:text="Log 50 moods." />

            <ProgressBar
                android:id="@+id/badge_row_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:max="100"
                android:visibility="gone"
                tools:progress="74"
                tools:visibility="visible" />

        </LinearLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/badge_row_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:gravity="end"
            android:textSize="@dimen/smaller_text_size"
            android:textStyle="bold"
            tools:text="37 / 50" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
