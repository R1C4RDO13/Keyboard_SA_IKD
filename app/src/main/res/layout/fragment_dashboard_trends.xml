<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.11: Trends tab content. Three IKD line charts (WPM / Avg IKD /
    Error rate) plus the Phase 9.2 gyro/accel global trend charts. The
    section header is gone — the NavigationRail label replaces it.
    Phase 9.13: each chart title shares its row with a tap-to-explain
    info icon.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_trends_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/normal_margin">

        <!-- Speed chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_chart_speed"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dashboard_chart_speed_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/small_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/widget_info_content_description"
                android:focusable="true"
                android:src="@drawable/ic_info_outline_vector" />

        </LinearLayout>

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_speed"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin" />

        <!-- IKD chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_chart_ikd"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dashboard_chart_ikd_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/small_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/widget_info_content_description"
                android:focusable="true"
                android:src="@drawable/ic_info_outline_vector" />

        </LinearLayout>

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_ikd"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin" />

        <!-- Error rate chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_chart_error"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dashboard_chart_error_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/small_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/widget_info_content_description"
                android:focusable="true"
                android:src="@drawable/ic_info_outline_vector" />

        </LinearLayout>

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_error"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin" />

        <!-- Phase 9.2: Gyro magnitude trend chart -->
        <LinearLayout
            android:id="@+id/dashboard_chart_gyro_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dashboard_chart_gyro_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_chart_gyro_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dashboard_chart_gyro_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/small_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/widget_info_content_description"
                android:focusable="true"
                android:src="@drawable/ic_info_outline_vector" />

        </LinearLayout>

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_gyro"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin"
            android:visibility="gone" />

        <!-- Phase 9.2: Accel magnitude trend chart -->
        <LinearLayout
            android:id="@+id/dashboard_chart_accel_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dashboard_chart_accel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_chart_accel_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dashboard_chart_accel_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/small_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/widget_info_content_description"
                android:focusable="true"
                android:src="@drawable/ic_info_outline_vector" />

        </LinearLayout>

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_accel"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin"
            android:visibility="gone" />

        <!-- Phase 15: Avg session duration chart relocated here from the
             dropped Habits tab. Backed by the same IkdHabitsAggregator
             output already carried in the payload. -->
        <LinearLayout
            android:id="@+id/dashboard_chart_habits_session_duration_title_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/dashboard_chart_habits_session_duration_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_chart_habits_session_duration_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/dashboard_chart_habits_session_duration_info"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/small_margin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/widget_info_content_description"
                android:focusable="true"
                android:src="@drawable/ic_info_outline_vector" />

        </LinearLayout>

        <org.fossify.keyboard.views.IkdLineChartView
            android:id="@+id/dashboard_chart_habits_session_duration"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="@dimen/small_margin"
            android:visibility="gone" />

        <!-- Phase 9.8: Orientation breakdown donut. Relocated here from
             the Keystroke Dynamics tab (owner directive). Backed by the
             same IkdOrientationAggregator output already carried in the
             payload — no aggregator/DAO change. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_orientation_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normal_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <org.fossify.commons.views.MyTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_chart_orientation_title"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/dashboard_orientation_info"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="@dimen/small_margin"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/widget_info_content_description"
                        android:focusable="true"
                        android:src="@drawable/ic_info_outline_vector" />

                </LinearLayout>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/dashboard_orientation_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/small_margin" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin"
                    android:fillViewport="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/dashboard_orientation_legend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Empty placeholder when this tab has no data to show. -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/fragment_trends_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/activity_margin"
            android:text="@string/dashboard_tab_empty_message"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
