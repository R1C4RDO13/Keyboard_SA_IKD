<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.11: Daily Activity tab content. Calendar heatmap (9.5), daily
    keypress bar (9.5), 24-hour bar (9.6), circadian heatmap (9.6), and
    the Usage Map bubble chart (9.9). All five cards are GONE by default;
    the activity flips visibility per snapshot just like before.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_daily_activity_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/normal_margin">

        <!-- Phase 9.5: Calendar heatmap card. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_calendar_heatmap_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normal_margin">

                <org.fossify.commons.views.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_chart_calendar_heatmap_title"
                    android:textStyle="bold" />

                <org.fossify.keyboard.views.IkdHeatmapView
                    android:id="@+id/dashboard_calendar_heatmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Phase 9.5: Daily keypress bar chart card. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_daily_keypress_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normal_margin">

                <org.fossify.commons.views.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_chart_daily_keypress_title"
                    android:textStyle="bold" />

                <org.fossify.keyboard.views.IkdLineChartView
                    android:id="@+id/dashboard_daily_keypress_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/small_margin" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Phase 9.6: 24-hour bar chart card. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_hourly_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normal_margin">

                <org.fossify.commons.views.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_chart_hourly_title"
                    android:textStyle="bold" />

                <org.fossify.keyboard.views.IkdLineChartView
                    android:id="@+id/dashboard_hourly_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/small_margin" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Phase 9.6: Circadian (hour×weekday) heatmap card. Always
             all-time per orchestrator Decision #18. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_circadian_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normal_margin">

                <org.fossify.commons.views.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_chart_circadian_title"
                    android:textStyle="bold" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/dashboard_circadian_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_circadian_subtitle"
                    android:textSize="@dimen/smaller_text_size"
                    android:textStyle="italic" />

                <org.fossify.keyboard.views.IkdHeatmapView
                    android:id="@+id/dashboard_circadian_heatmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Phase 9.9: Usage Map bubble chart card. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard_usage_map_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/normal_margin"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/normal_margin">

                <org.fossify.commons.views.MyTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_chart_usage_map_title"
                    android:textStyle="bold" />

                <org.fossify.keyboard.views.IkdBubbleMapView
                    android:id="@+id/dashboard_usage_map"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/small_margin" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Empty placeholder when this tab has no data to show. -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/fragment_daily_activity_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/activity_margin"
            android:text="@string/dashboard_tab_empty_message"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
