<resources>
    <dimen name="popup_max_move_distance">60dp</dimen>
    <dimen name="top_small_number_margin_width">5dp</dimen>
    <dimen name="top_small_number_margin_height">5dp</dimen>
    <dimen name="toolbar_height">46dp</dimen>
    <dimen name="toolbar_icon_height">32dp</dimen>
    <dimen name="clip_drag_icon_height">40dp</dimen>
    <dimen name="key_height">60dp</dimen>
    <dimen name="vertical_correction">-10dp</dimen>
    <dimen name="clip_pin_size">28dp</dimen>
    <dimen name="emoji_item_size">42dp</dimen>
    <dimen name="emoji_category_item_size">24dp</dimen>
    <dimen name="emoji_palette_btn_size">42dp</dimen>
    <dimen name="suggestion_max_width">200dp</dimen>

    <dimen name="keyboard_text_size">22sp</dimen>
    <dimen name="preview_text_size">26sp</dimen>
    <dimen name="label_text_size">16sp</dimen>      <!-- text size used at keys with longer labels, like "123" -->
    <dimen name="emoji_text_size">30sp</dimen>
    <dimen name="emoji_category_text_size">13sp</dimen>
    <dimen name="space_bar_text_size">13sp</dimen>

    <!-- Phase 5 — session dashboard cards & charts -->
    <dimen name="card_corner_radius">12dp</dimen>
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="session_dashboard_chart_height">200dp</dimen>

    <!-- Phase 8 — keyboard mood bar -->
    <dimen name="mood_bar_height">40dp</dimen>
    <dimen name="mood_bar_button_size">36dp</dimen>
    <dimen name="mood_bar_button_text_size">20sp</dimen>
    <dimen name="mood_bar_button_gap">2dp</dimen>
    <dimen name="mood_bar_privacy_gap">8dp</dimen>
    <dimen name="mood_bar_background_corner_radius">20dp</dimen>
    <dimen name="mood_bar_horizontal_padding">8dp</dimen>

    <!-- Phase 8.2 — chat-bubble popup that surfaces above a tapped mood slot -->
    <dimen name="mood_bubble_corner_radius">14dp</dimen>
    <dimen name="mood_bubble_horizontal_padding">12dp</dimen>
    <dimen name="mood_bubble_vertical_padding">6dp</dimen>
    <dimen name="mood_bubble_anchor_margin">6dp</dimen>

    <!-- Phase 8.5 — collapsible mood bar chevron icon. Sized smaller than
         the slot buttons so the chip silhouette stays compact. -->
    <dimen name="mood_bar_chevron_size">28dp</dimen>

    <!-- Phase 8.5 — collapsed-state indicator (the chip emoji). Wider
         than a slot so the chip reads as a deliberate "your mood"
         affordance and is easier to tap. Glyph size is bumped well
         above the slot's 20sp so the chip reads from a glance even
         at thumb-distance — the emoji overflows the view bounds but
         the parent has `clipChildren="false"`, so rendering is safe. -->
    <dimen name="mood_bar_collapsed_indicator_width">48dp</dimen>
    <dimen name="mood_bar_collapsed_indicator_text_size">28sp</dimen>

    <!-- Phase 9.5 — calendar / circadian heatmap cells -->
    <dimen name="heatmap_cell_min_size_dp">12dp</dimen>
    <dimen name="heatmap_cell_corner_dp">2dp</dimen>
    <dimen name="heatmap_cell_margin_dp">2dp</dimen>

    <!-- Phase 9.9 — Usage Map bubbles -->
    <dimen name="bubble_map_min_radius_dp">1dp</dimen>
    <dimen name="bubble_map_max_radius_dp">12dp</dimen>

    <!-- Phase 9.12 — global KPI strip cell minimum width when wrapped in
         a horizontal scroller (6 cells overflow narrow phones). -->
    <dimen name="dashboard_kpi_cell_min_width">72dp</dimen>

    <!-- Phase 9.14.3 — outlined silhouette for the active filter chip and
         the bottom-sheet's range/mood chips so the runtime Fossify primary
         tone reads against the activity background. -->
    <dimen name="chip_stroke_width">1dp</dimen>

    <!-- Phase 9.17 — Mood Distribution tile row at the top of the
         Summary tab. Six tiles at 60dp wide ≈ 360dp total: fits a
         typical viewport and overflows narrow widths via the parent
         HorizontalScrollView. Height ~76dp matches the preview. -->
    <dimen name="summary_mood_tile_width">60dp</dimen>
    <dimen name="summary_mood_tile_height">76dp</dimen>

    <!-- Phase 9.18 — Mood Distribution tiles double as the Mood Filter.
         The active tile gets a primary-tinted MaterialCardView stroke at
         this width; inactive tiles render with strokeWidth=0. Sized to
         read on a coloured tile background without overpowering the
         emoji + percentage typography. -->
    <dimen name="summary_mood_tile_stroke_active">1.5dp</dimen>
</resources>
