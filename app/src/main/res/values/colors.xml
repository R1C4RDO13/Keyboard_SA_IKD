<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="key_press_color">#11ffffff</color>

    <!-- Phase 6 rework: status chip palette (light mode).
         Foregrounds are picked per state for WCAG AA contrast against
         the matching background. The amber state needs black text;
         green / grey states keep white. -->
    <color name="ikd_status_active">#2E7D32</color>
    <color name="ikd_status_active_text">#FFFFFFFF</color>
    <color name="ikd_status_idle">#9E9E9E</color>
    <color name="ikd_status_idle_text">#FFFFFFFF</color>
    <color name="ikd_status_privacy">#F57F17</color>
    <color name="ikd_status_privacy_text">#FF000000</color>
    <color name="ikd_status_no_data">#9E9E9E</color>
    <color name="ikd_status_no_data_text">#FFFFFFFF</color>

    <!-- Phase 9.17 mood palette refresh: match conventional emotion-colour
         mappings (yellow = happy, orange = surprise, green = disgust,
         deep blue = sad, purple = fear, red = anger). Sadness uses
         Material Blue 900 so it reads as a heavier, more melancholy
         tone next to the Happiness gold on the new Summary-tab tile
         row. Phase 8.3 palette docs preserved in `mood_color_*`
         comments via the dark-mode counterpart in values-night. -->
    <color name="mood_color_happiness">#F9A825</color>
    <color name="mood_color_surprise">#EF6C00</color>
    <color name="mood_color_disgust">#558B2F</color>
    <color name="mood_color_sadness">#0D47A1</color>
    <color name="mood_color_fear">#6A1B9A</color>
    <color name="mood_color_anger">#C62828</color>

    <!-- Phase 9.8: orientation donut palette (light mode).
         Five tints distinct from the mood-mix palette. -->
    <color name="orientation_color_portrait">#1976D2</color>
    <color name="orientation_color_landscape">#388E3C</color>
    <color name="orientation_color_face_up">#7B1FA2</color>
    <color name="orientation_color_face_down">#0097A7</color>
    <color name="orientation_color_unknown">#9E9E9E</color>
</resources>
