<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 9.14.2: tint selector for the dashboard TabLayout's icons.
    Selected → primary (Fossify theme primary); unselected →
    colorControlNormal (the same secondary tint used by other
    chrome-state icons in the app).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="?attr/colorPrimary" />
    <item android:color="?attr/colorControlNormal" />
</selector>
