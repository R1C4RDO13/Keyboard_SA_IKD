<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 6 rework: dark-mode counterpart for the diagnostics status chip
  palette. Uses lighter, less-saturated variants so the chip reads as a
  coloured pill on dark backgrounds without screaming. Matches the
  colour names in res/values/colors.xml so ContextCompat.getColor()
  resolves the right value automatically.
-->
<resources>
    <color name="ikd_status_active">#66BB6A</color>
    <color name="ikd_status_active_text">#FF000000</color>
    <color name="ikd_status_idle">#BDBDBD</color>
    <color name="ikd_status_idle_text">#FF000000</color>
    <color name="ikd_status_privacy">#FFB300</color>
    <color name="ikd_status_privacy_text">#FF000000</color>
    <color name="ikd_status_no_data">#757575</color>
    <color name="ikd_status_no_data_text">#FFFFFFFF</color>

    <!-- Phase 9.17 mood palette refresh (dark mode counterpart).
         Same conventional mappings as the light palette, picked one
         shade lighter so each colour reads cleanly on dark backgrounds.
         Sadness, Fear and Anger were already in the right tonal range
         and are preserved verbatim from Phase 8.3. Happiness moves
         from green → warm amber, Surprise from teal → light orange,
         Disgust from olive → leafy green. -->
    <color name="mood_color_happiness">#FFD54F</color>
    <color name="mood_color_surprise">#FFB74D</color>
    <color name="mood_color_disgust">#9CCC65</color>
    <color name="mood_color_sadness">#42A5F5</color>
    <color name="mood_color_fear">#AB47BC</color>
    <color name="mood_color_anger">#EF5350</color>

    <!-- Phase 9.8: orientation donut palette (dark mode). -->
    <color name="orientation_color_portrait">#42A5F5</color>
    <color name="orientation_color_landscape">#66BB6A</color>
    <color name="orientation_color_face_up">#AB47BC</color>
    <color name="orientation_color_face_down">#26C6DA</color>
    <color name="orientation_color_unknown">#BDBDBD</color>

    <!-- Phase 14: badge card state tints (dark mode counterpart).
         Darker locked slab + track so a not-yet-earned card recedes on
         a dark theme; a lighter green glow so the earned-card border
         reads cleanly. Same colour names as values/colors.xml. -->
    <color name="badge_locked_surface">#262626</color>
    <color name="badge_locked_bar">#3A3A3A</color>
    <color name="badge_unlocked_glow">#7FC88A</color>
</resources>
