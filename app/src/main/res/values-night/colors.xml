<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 6 rework: dark-mode counterpart for the diagnostics status chip
  palette. Uses lighter, less-saturated variants so the chip reads as a
  coloured pill on dark backgrounds without screaming. Matches the
  colour names in res/values/colors.xml so ContextCompat.getColor()
  resolves the right value automatically.
-->
<resources>
    <color name="ikd_status_active">#66BB6A</color>
    <color name="ikd_status_active_text">#FF000000</color>
    <color name="ikd_status_idle">#BDBDBD</color>
    <color name="ikd_status_idle_text">#FF000000</color>
    <color name="ikd_status_privacy">#FFB300</color>
    <color name="ikd_status_privacy_text">#FF000000</color>
    <color name="ikd_status_no_data">#757575</color>
    <color name="ikd_status_no_data_text">#FFFFFFFF</color>

    <!-- Phase 8.3: mood-mix stacked-bar palette (dark mode).
         Lighter, less-saturated variants so each band reads cleanly on
         dark backgrounds without screaming. Same colour names as the
         light palette so ContextCompat.getColor() resolves automatically. -->
    <color name="mood_color_happiness">#66BB6A</color>
    <color name="mood_color_surprise">#4DD0E1</color>
    <color name="mood_color_disgust">#C0CA33</color>
    <color name="mood_color_sadness">#42A5F5</color>
    <color name="mood_color_fear">#AB47BC</color>
    <color name="mood_color_anger">#EF5350</color>
</resources>
