<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.2: chat-bubble background for the mood-tap popup. Same fill +
     stroke pattern as the mood-bar capsule and the keyboard key-preview
     popup; both layers are tinted at runtime in MyKeyboardView via
     LayerDrawable.findDrawableByLayerId so the bubble follows the active
     theme automatically. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/mood_bubble_background_shape">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_grey_800" />
            <corners android:radius="@dimen/mood_bubble_corner_radius" />
        </shape>
    </item>
    <item android:id="@+id/mood_bubble_background_stroke">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/md_grey_600" />
            <corners android:radius="@dimen/mood_bubble_corner_radius" />
        </shape>
    </item>
</layer-list>
