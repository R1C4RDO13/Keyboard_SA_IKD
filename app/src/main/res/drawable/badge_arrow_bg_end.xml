<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 14: background for the RIGHT (› next) Achievements carousel
    arrow. Flush to the screen's trailing edge — the outer (end) corners
    are square; only the inner (start) corners are rounded. Solid fill is
    runtime-tinted to the primary tone in BadgeGroupAdapter so the arrow
    contrasts with the badge card behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners
        android:topLeftRadius="@dimen/card_corner_radius"
        android:bottomLeftRadius="@dimen/card_corner_radius"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
