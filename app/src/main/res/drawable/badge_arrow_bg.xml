<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 14: background for the Achievements carousel ‹ / › arrows.
    A rounded-rect solid fill (runtime-tinted to getProperBackgroundColor
    in BadgeGroupAdapter) so the button reads as a raised surface; paired
    with android:elevation in the layout it casts a small shadow that
    lifts the arrow off the badge card behind it (owner: "I cannot see
    them properly").
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="@dimen/card_corner_radius" />
</shape>
