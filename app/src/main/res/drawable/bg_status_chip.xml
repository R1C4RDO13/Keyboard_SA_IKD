<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 6 rework: base solid colour is the theme's colorControlNormal so
  that, even without a runtime backgroundTintList, the chip renders a
  theme-appropriate base. Per-state tints are applied in code via
  setBackgroundTintList(...) in DiagnosticsActivity.updateStatusDisplay().
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="?attr/colorControlNormal" />
</shape>
