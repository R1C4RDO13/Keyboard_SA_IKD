<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 8.2: rounded "stretched key" background for the mood bar.
     Both layers are tinted at runtime in MyKeyboardView.setupKeyboard()
     to track the active theme (mKeyColor for fill, mStrokeColor for the
     border) — matching the existing clipboard-chip pattern. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/mood_bar_background_shape">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_grey_800" />
            <corners android:radius="@dimen/mood_bar_background_corner_radius" />
        </shape>
    </item>
    <item android:id="@+id/mood_bar_background_stroke">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/md_grey_600" />
            <corners android:radius="@dimen/mood_bar_background_corner_radius" />
        </shape>
    </item>
</layer-list>
